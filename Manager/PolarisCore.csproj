<Project Sdk="Microsoft.NET.Sdk">

  <!-- 产品身份（程序集名 PolarisCore、GUID Polaris）保持不变，安装器与自动更新链路不用动；库本体在 PolarisLib。 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PolarisCore</AssemblyName>
    <RootNamespace>Polaris</RootNamespace>
    <Product>AIC-Polaris</Product>
    <Version>2.0.4</Version>
    <BepInExPluginGuid>Polaris</BepInExPluginGuid>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RequiresAicGame>true</RequiresAicGame>
    <!-- 库与管理器各自生成一份 MyPluginInfo，本项目内的那份优先，属预期。 -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <Import Project="..\build\Polaris.Runtime.props" />

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lib\PolarisLib.csproj" />
  </ItemGroup>

</Project>
