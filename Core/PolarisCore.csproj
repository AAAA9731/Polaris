<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PolarisCore</AssemblyName>
    <RootNamespace>Polaris</RootNamespace>
    <Product>AIC-Polaris-Core</Product>
    <Version>0.1.0</Version>
    <BepInExPluginGuid>Polaris.Core</BepInExPluginGuid>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RequiresAicGame>true</RequiresAicGame>
  </PropertyGroup>

  <Import Project="..\build\Polaris.Runtime.props" />

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="NVorbis" Version="0.10.*" />
  </ItemGroup>

</Project>
