<Window x:Class="PolarisInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Polaris" Width="800" Height="620" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}"
        AllowDrop="True" Drop="OnDrop" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Orientation="Horizontal">
            <Image Source="logo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{StaticResource InkSoft}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 游戏目录 -->
        <Border Grid.Row="1" Margin="0,18,0,14" Padding="14,12" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="GamePathLabel" FontSize="12" Foreground="{StaticResource InkSoft}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" IsReadOnly="True" FontSize="14" Padding="8,6" Background="White" BorderBrush="{StaticResource Line}" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource PlainButton}" Margin="8,0,0,0" Click="OnBrowse" />
                </Grid>
                <TextBlock x:Name="PathMessage" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="14,12" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White">
                            <StackPanel>
                                <TextBlock x:Name="BepLabel" FontSize="12" Foreground="{StaticResource InkSoft}" />
                                <TextBlock x:Name="BepStatus" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="14,12" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White">
                            <StackPanel>
                                <TextBlock x:Name="PolLabel" FontSize="12" Foreground="{StaticResource InkSoft}" />
                                <TextBlock x:Name="PolStatus" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Foreground="#F7F4EE" Click="OnInstall" />
                            <Button x:Name="UninstallButton" Style="{StaticResource PlainButton}" Click="OnUninstall" />
                        </StackPanel>
                        <CheckBox x:Name="RemoveBepCheck" Margin="0,12,0,0" FontSize="13" />
                        <ProgressBar x:Name="Progress" Height="4" Margin="0,14,0,0" IsIndeterminate="False" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0" />
                    </StackPanel>

                    <TextBox x:Name="LogBox" Grid.Row="2" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="{StaticResource InkSoft}" />
                </Grid>
        </Border>
    </Grid>
</Window>
