<Window x:Class="PolarisInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Polaris" Width="800" Height="620" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}"
        AllowDrop="True" Drop="OnDrop" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Orientation="Horizontal">
            <Image Source="logo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="{StaticResource InkSoft}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 游戏目录 -->
        <Border Grid.Row="1" Margin="0,18,0,14" Padding="14,12" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="GamePathLabel" FontSize="12" Foreground="{StaticResource InkSoft}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" IsReadOnly="True" FontSize="14" Padding="8,6" Background="White" BorderBrush="{StaticResource Line}" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource PlainButton}" Margin="8,0,0,0" Click="OnBrowse" />
                    <Button x:Name="DetectButton" Grid.Column="2" Style="{StaticResource PlainButton}" Margin="8,0,0,0" Click="OnDetect" />
                </Grid>
                <TextBlock x:Name="PathMessage" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" x:Name="Tabs" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" FontSize="14">
            <!-- 安装 -->
            <TabItem x:Name="TabInstall">
                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="14,12" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White">
                            <StackPanel>
                                <TextBlock x:Name="BepLabel" FontSize="12" Foreground="{StaticResource InkSoft}" />
                                <TextBlock x:Name="BepStatus" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="14,12" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White">
                            <StackPanel>
                                <TextBlock x:Name="PolLabel" FontSize="12" Foreground="{StaticResource InkSoft}" />
                                <TextBlock x:Name="PolStatus" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Foreground="#F7F4EE" Click="OnInstall" />
                            <Button x:Name="UninstallButton" Style="{StaticResource PlainButton}" Click="OnUninstall" />
                        </StackPanel>
                        <CheckBox x:Name="RemoveBepCheck" Margin="0,12,0,0" FontSize="13" />
                        <ProgressBar x:Name="Progress" Height="4" Margin="0,14,0,0" IsIndeterminate="False" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0" />
                    </StackPanel>

                    <TextBox x:Name="LogBox" Grid.Row="2" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="{StaticResource InkSoft}" />
                </Grid>
            </TabItem>

            <!-- 模组 -->
            <TabItem x:Name="TabMods">
                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ModsHint" Foreground="{StaticResource InkSoft}" FontSize="13" TextWrapping="Wrap" />
                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <ListBox x:Name="ModList" Background="White" BorderBrush="{StaticResource Line}" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnModToggle" VerticalContentAlignment="Center">
                                            <StackPanel Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" />
                                                <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource InkSoft}" />
                                                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{StaticResource Accent}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ModsEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" TextAlignment="Center" Margin="30" />
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="AddModButton" Style="{StaticResource PlainButton}" Click="OnAddMod" />
                        <Button x:Name="OpenModsButton" Style="{StaticResource PlainButton}" Click="OnOpenMods" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 诊断 -->
            <TabItem x:Name="TabDiag">
                <StackPanel Margin="20,18">
                    <TextBlock x:Name="DiagHint" TextWrapping="Wrap" FontSize="14" />
                    <TextBlock x:Name="LastReportText" Margin="0,14,0,0" Foreground="{StaticResource InkSoft}" FontSize="13" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="OpenReportsButton" Style="{StaticResource PlainButton}" Click="OnOpenReports" />
                        <Button x:Name="OpenLogButton" Style="{StaticResource PlainButton}" Click="OnOpenLog" />
                        <Button x:Name="OpenGameButton" Style="{StaticResource PlainButton}" Click="OnOpenGame" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
