<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PolarisCore</AssemblyName>
    <RootNamespace>Polaris</RootNamespace>
    <Product>AIC-Polaris</Product>
    <Version>2.0.1</Version>
    <BepInExPluginGuid>Polaris</BepInExPluginGuid>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RequiresAicGame>true</RequiresAicGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- 崩溃观察者与安装器是独立项目，不能被 Core 的 **/*.cs 通配吃进去。 -->
    <Compile Remove="Watcher\**;Installer\**" />
    <None Remove="Watcher\**;Installer\**" />
    <EmbeddedResource Remove="Watcher\**;Installer\**" />
  </ItemGroup>

  <Import Project="build\Polaris.Runtime.props" />

  <ItemGroup>
    <!-- 只有 Core 生成 BepInEx 插件元数据；组件项目不得生成插件入口信息。 -->
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

</Project>
